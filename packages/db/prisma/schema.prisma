// Schema v1: profiles, organizations, memberships -- the identity/tenancy
// foundation every future feature depends on. See docs/DATABASE.md for the
// full design rationale and docs/decisions/ for the ADRs this implements.
//
// Deliberately scoped to the `public` schema only. `profiles.id` carries a
// real foreign key into Supabase's `auth.users` table, but that FK is added
// as a manual SQL statement appended to the generated migration (see
// migration.sql) rather than declaring `auth.users` as a Prisma model.
// Letting Prisma manage a model in `auth` would make `prisma migrate dev`'s
// shadow-database diffing try to create/compare a table it doesn't actually
// own -- Supabase's real `auth.users` has a different structure than an
// empty shadow DB would have. Keeping Prisma scoped to `public` avoids that
// entirely while still getting a real, DB-enforced FK constraint.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  individual
  clinic
}

enum MembershipRole {
  owner
  psychologist
  admin_staff
}

enum MembershipStatus {
  active
  // Unused: an invitee usually has no profile yet, so invitations live in
  // their own table (ADR-0013). Kept for a future suspend/reinstate flow.
  invited
  suspended
}

enum InvitationStatus {
  pending
  accepted
  revoked
}

// `archived` replaces deletion (ADR-0014): only an owner can archive or
// restore, and nothing is ever hard-deleted through the application.
enum PatientStatus {
  active
  inactive
  archived
}

// `cancelled` is the only status that frees the time slot (ADR-0015).
enum AppointmentStatus {
  scheduled
  confirmed
  completed
  cancelled
  no_show
}

enum AppointmentModality {
  in_person
  online
}

// 1:1 shadow of Supabase's auth.users (see note above re: the FK).
model Profile {
  id        String   @id @db.Uuid
  fullName  String?  @map("full_name")
  phone     String?
  locale    String   @default("en")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  memberships          Membership[]
  createdOrganizations Organization[]

  @@map("profiles")
}

model Organization {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  slug             String           @unique
  type             OrganizationType @default(individual)
  subscriptionTier String?          @map("subscription_tier")
  settings         Json             @default("{}")
  // Who created this organization. Required for auditability, and load-bearing
  // for RLS: it's what lets the creator see their own organization during the
  // single transaction that bootstraps it, before any membership row exists.
  // See docs/SECURITY.md.
  createdBy        String           @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz

  creator          Profile               @relation(fields: [createdBy], references: [id])
  memberships      Membership[]
  invitations      Invitation[]
  patients         Patient[]
  appointments     Appointment[]
  clinicalSessions ClinicalSession[]
  clinicalNotes    ClinicalNote[]
  noteVersions     ClinicalNoteVersion[]
  auditLogs        AuditLog[]

  // Created by migration 20261109172000 but never declared here, so a future
  // `prisma migrate dev` would have generated a DROP for it. Caught by the CI
  // drift check (migrations vs this schema).
  @@index([createdBy])
  @@map("organizations")
}

model Membership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MembershipRole   @default(psychologist)
  status         MembershipStatus @default(active)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile      Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  sentInvitations     Invitation[]          @relation("InvitationInviter")
  acceptedInvitations Invitation[]          @relation("InvitationAcceptor")
  createdPatients     Patient[]             @relation("PatientCreator")
  appointments        Appointment[]         @relation("AppointmentProfessional")
  createdAppointments Appointment[]         @relation("AppointmentCreator")
  clinicalSessions    ClinicalSession[]     @relation("SessionProfessional")
  createdSessions     ClinicalSession[]     @relation("SessionCreator")
  authoredNotes       ClinicalNote[]
  noteVersions        ClinicalNoteVersion[]

  // ADR-0004: this is the compound unique index every future composite FK
  // referencing "a user acting within an org" (professional_id, author_id,
  // ...) will target -- column order matches docs/DATABASE.md exactly.
  @@unique([organizationId, userId])
  // Same story: added in 20261109160500 (advisor-flagged unindexed FK) but
  // missing from the schema until the CI drift check found it.
  @@index([userId])
  @@map("memberships")
}

// An owner's offer for someone to join their organization (ADR-0013). Lives
// apart from `memberships` because the invitee usually has no profile yet.
// Only the SHA-256 hash of the link token is stored -- never the token.
model Invitation {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  // Always stored lower-cased (CHECK constraint in the migration).
  email          String
  // Never 'owner' (CHECK constraint): ownership transfer is not an invite.
  role           MembershipRole
  tokenHash      String           @unique @map("token_hash")
  status         InvitationStatus @default(pending)
  invitedBy      String           @map("invited_by") @db.Uuid
  acceptedBy     String?          @map("accepted_by") @db.Uuid
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // ADR-0004: "a user acting within an org" -> composite FK to memberships,
  // so neither the inviter nor the acceptor can belong to another org.
  inviter      Membership   @relation("InvitationInviter", fields: [organizationId, invitedBy], references: [organizationId, userId], onDelete: NoAction)
  acceptor     Membership?  @relation("InvitationAcceptor", fields: [organizationId, acceptedBy], references: [organizationId, userId], onDelete: NoAction)

  @@unique([id, organizationId])
  // Cover both composite FKs; organization_id leads, so these also serve as
  // the per-tenant index every tenant table carries.
  @@index([organizationId, invitedBy])
  @@index([organizationId, acceptedBy])
  @@map("invitations")
}

// F-005. Every column is personal data -- see docs/DATA-INVENTORY.md before
// adding one. Deliberately absent: national_id, a free-text notes field
// (clinical content would leak to admin_staff), assigned professional and
// consent timestamp (no MVP feature needs them yet). See ADR-0014.
model Patient {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String        @map("organization_id") @db.Uuid
  fullName              String        @map("full_name")
  dateOfBirth           DateTime?     @map("date_of_birth") @db.Date
  // Stored lower-cased (CHECK constraint in the migration).
  email                 String?
  phone                 String?
  emergencyContactName  String?       @map("emergency_contact_name")
  emergencyContactPhone String?       @map("emergency_contact_phone")
  status                PatientStatus @default(active)
  createdBy             String        @map("created_by") @db.Uuid
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt            DateTime?     @map("archived_at") @db.Timestamptz

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // ADR-0004: the creator is "a user acting within an org".
  creator          Membership        @relation("PatientCreator", fields: [organizationId, createdBy], references: [organizationId, userId], onDelete: NoAction)
  appointments     Appointment[]
  clinicalSessions ClinicalSession[]

  // ADR-0004: target of every future composite FK (appointments, sessions...).
  @@unique([id, organizationId])
  @@index([organizationId, createdBy])
  // The list is ordered by name within one organization.
  @@index([organizationId, fullName])
  @@map("patients")
}

// F-006/F-007, ADR-0015. Double-booking is made impossible by two exclusion
// constraints in the migration (Prisma cannot express them): per
// organization, no two non-cancelled appointments of the same professional,
// or of the same patient, may overlap. Deliberately no free-text notes field
// (clinical content would be visible to admin_staff).
model Appointment {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  // Immutable after creation (no UPDATE grant on the column).
  patientId      String              @map("patient_id") @db.Uuid
  // Must be an active owner/psychologist (RLS, is_active_clinician).
  professionalId String              @map("professional_id") @db.Uuid
  scheduledStart DateTime            @map("scheduled_start") @db.Timestamptz
  scheduledEnd   DateTime            @map("scheduled_end") @db.Timestamptz
  status         AppointmentStatus   @default(scheduled)
  modality       AppointmentModality @default(in_person)
  createdBy      String              @map("created_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  cancelledAt    DateTime?           @map("cancelled_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // ADR-0004: composite FKs, so neither the patient nor the professional can
  // belong to another organization.
  patient      Patient      @relation(fields: [patientId, organizationId], references: [id, organizationId], onDelete: NoAction)
  professional Membership   @relation("AppointmentProfessional", fields: [organizationId, professionalId], references: [organizationId, userId], onDelete: NoAction)
  creator      Membership   @relation("AppointmentCreator", fields: [organizationId, createdBy], references: [organizationId, userId], onDelete: NoAction)

  // At most one, enforced by clinical_sessions.appointment_id UNIQUE; modeled
  // as a list because the FK is composite (appointment, organization, patient).
  clinicalSessions ClinicalSession[]

  @@unique([id, organizationId])
  // Target of clinical_sessions' (appointment, organization, patient) FK: a
  // session recorded for an appointment must be for that appointment's
  // patient (ADR-0016).
  @@unique([id, organizationId, patientId])
  // Calendar queries: the whole practice, or one professional, by time.
  @@index([organizationId, scheduledStart])
  @@index([organizationId, professionalId, scheduledStart])
  @@index([organizationId, patientId])
  @@index([organizationId, createdBy])
  @@map("appointments")
}

// F-008, ADR-0016. That a session took place -- distinct from the appointment
// that scheduled it. Created/edited only by owner/psychologist; readable by
// admin_staff as metadata for billing. No content here: clinical content
// lives only in clinical_note_versions.
model ClinicalSession {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  patientId       String   @map("patient_id") @db.Uuid
  professionalId  String   @map("professional_id") @db.Uuid
  // Optional; at most one session per appointment, and only for that
  // appointment's own patient (composite FK below).
  appointmentId   String?  @unique @map("appointment_id") @db.Uuid
  startedAt       DateTime @map("started_at") @db.Timestamptz
  durationMinutes Int      @map("duration_minutes")
  createdBy       String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient        @relation(fields: [patientId, organizationId], references: [id, organizationId], onDelete: NoAction)
  professional Membership     @relation("SessionProfessional", fields: [organizationId, professionalId], references: [organizationId, userId], onDelete: NoAction)
  creator      Membership     @relation("SessionCreator", fields: [organizationId, createdBy], references: [organizationId, userId], onDelete: NoAction)
  appointment  Appointment?   @relation(fields: [appointmentId, organizationId, patientId], references: [id, organizationId, patientId], onDelete: NoAction)
  notes        ClinicalNote[]

  @@unique([id, organizationId])
  @@index([organizationId, patientId, startedAt])
  @@index([organizationId, professionalId])
  @@index([organizationId, createdBy])
  @@map("clinical_sessions")
}

// F-009, ADR-0006 as amended by ADR-0016. One note per (session, author).
// Immutable: app_runtime has no UPDATE or DELETE on this table at all -- the
// note's text lives in its versions, and the current text is the highest
// version.
model ClinicalNote {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  clinicalSessionId String   @map("clinical_session_id") @db.Uuid
  // Only this person may ever add a version (RLS + use case).
  authorId          String   @map("author_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      ClinicalSession       @relation(fields: [clinicalSessionId, organizationId], references: [id, organizationId], onDelete: NoAction)
  author       Membership            @relation(fields: [organizationId, authorId], references: [organizationId, userId], onDelete: NoAction)
  versions     ClinicalNoteVersion[]

  @@unique([id, organizationId])
  @@unique([clinicalSessionId, authorId])
  @@index([organizationId, authorId])
  @@map("clinical_notes")
}

// Append-only (ADR-0006): INSERT and SELECT only, never UPDATE or DELETE.
// The most sensitive column in the schema is `content`.
model ClinicalNoteVersion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  clinicalNoteId String   @map("clinical_note_id") @db.Uuid
  // 1, 2, 3...; unique per note, so two concurrent edits cannot both win.
  version        Int
  content        String
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  note         ClinicalNote @relation(fields: [clinicalNoteId, organizationId], references: [id, organizationId], onDelete: NoAction)
  creator      Membership   @relation(fields: [organizationId, createdBy], references: [organizationId, userId], onDelete: NoAction)

  @@unique([clinicalNoteId, version])
  @@index([organizationId, createdBy])
  @@map("clinical_note_versions")
}

// F-012. Append-only accountability trail; app_runtime may INSERT only --
// not even SELECT -- so the application can neither read nor tamper with it.
// Never stores clinical content: `metadata` holds identifiers and version
// numbers only. `actor_user_id` has no FK on purpose: the trail must outlive
// the actor's membership.
model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String   @map("actor_user_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String   @map("resource_id") @db.Uuid
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, resourceType, resourceId, createdAt])
  @@index([organizationId, actorUserId, createdAt])
  @@map("audit_logs")
}
