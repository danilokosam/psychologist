# Copy this file to .env and fill in real values for local development.

# HTTP port the Express server listens on.
PORT=4000

# One of: development | test | production
NODE_ENV=development

# Connection string for the `app_runtime` Postgres role, through Supavisor
# in TRANSACTION mode (port 6543). This role is deliberately NOBYPASSRLS and
# is not a table owner, so Row Level Security always applies to it -- the
# server refuses to start if the connected role can bypass RLS
# (see src/shared/db/assert-no-bypass-rls.ts).
#
# `pgbouncer=true` is required: Prisma must disable prepared statements,
# which a transaction-mode pooler does not support.
#
# NEVER point this at Supabase's `service_role`/secret connection -- that
# bypasses RLS by design and would silently defeat every policy.
DATABASE_URL="postgresql://app_runtime.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase project URL. Used to build the JWKS URL for verifying access
# tokens and to validate the `iss` claim. No secret needed: the project
# signs tokens with an asymmetric key (ES256), so the API only ever needs
# the public keys it fetches from the JWKS endpoint.
SUPABASE_URL="https://<project-ref>.supabase.co"
