# Copy this file to .env.local for local development.

# Base URL of the Express API. Exposed to the browser (NEXT_PUBLIC_) because
# the frontend calls the API directly over HTTP -- it never talks to
# Prisma/Postgres itself (see docs/ARCHITECTURE.md).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase project URL and PUBLISHABLE key. The publishable key is designed to
# be shipped to browsers; never put the secret/service_role key here -- any
# NEXT_PUBLIC_ variable ends up in the client bundle.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
